{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/cv", "destination": "/resume", "permanent": false },
    { "source": "/cv.pdf", "destination": "/resume.pdf", "permanent": false }
  ],
  "rewrites": [
    { "source": "/resume", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/resume.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "inline; filename=\"MahdiMosaviResume.pdf\"" }
      ]
    }
  ]
}
